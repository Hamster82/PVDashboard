{
  "type": "APL",
  "version": "2023.3",
  "theme": "dark",
  "settings": {
    "idleTimeout": 1800000
  },
  "resources": [
    {
      "colors": {
        "bg": "#11151b",
        "card": "#1b2129",
        "text": "#eef1f4",
        "muted": "#98a2ad",
        "sun": "#f2b134",
        "cons": "#5aa9e6",
        "good": "#4cc38a"
      }
    }
  ],
  "onMount": [
    {
      "type": "Sequential",
      "repeatCount": 96,
      "commands": [
        {
          "type": "Idle",
          "delay": 900000
        },
        {
          "type": "SendEvent",
          "arguments": [
            "refresh"
          ]
        }
      ]
    }
  ],
  "layouts": {
    "Kachel": {
      "parameters": [
        "label",
        "value",
        {
          "name": "farbe",
          "type": "string",
          "default": "#eef1f4"
        }
      ],
      "item": {
        "type": "Frame",
        "backgroundColor": "@card",
        "borderRadius": 12,
        "grow": 1,
        "paddingLeft": 14,
        "paddingRight": 14,
        "paddingTop": 8,
        "paddingBottom": 8,
        "item": {
          "type": "Container",
          "items": [
            {
              "type": "Text",
              "text": "${label}",
              "fontSize": 15,
              "color": "@muted",
              "maxLines": 1
            },
            {
              "type": "Text",
              "text": "${value}",
              "fontSize": 26,
              "fontWeight": "bold",
              "color": "${farbe}",
              "maxLines": 1
            }
          ]
        }
      }
    },
    "Balkenpaar": {
      "parameters": [
        "label",
        "yh",
        "ch",
        "yo",
        "co",
        "yv"
      ],
      "item": {
        "type": "Container",
        "grow": 1,
        "height": "100%",
        "justifyContent": "end",
        "alignItems": "center",
        "items": [
          {
            "type": "Text",
            "text": "${yv}",
            "fontSize": 14,
            "color": "@sun",
            "maxLines": 1
          },
          {
            "type": "Container",
            "direction": "row",
            "alignItems": "end",
            "spacing": 4,
            "items": [
              {
                "type": "Frame",
                "width": 22,
                "height": "${yh}",
                "borderRadius": 3,
                "backgroundColor": "@sun",
                "opacity": "${yo}"
              },
              {
                "type": "Frame",
                "width": 22,
                "height": "${ch}",
                "borderRadius": 3,
                "backgroundColor": "@cons",
                "opacity": "${co}",
                "spacing": 4
              }
            ]
          },
          {
            "type": "Text",
            "text": "${label}",
            "fontSize": 15,
            "color": "@muted",
            "spacing": 6,
            "maxLines": 1
          }
        ]
      }
    },
    "Legende": {
      "parameters": [],
      "item": {
        "type": "Container",
        "direction": "row",
        "alignItems": "center",
        "items": [
          {
            "type": "Frame",
            "width": 12,
            "height": 12,
            "borderRadius": 2,
            "backgroundColor": "@sun"
          },
          {
            "type": "Text",
            "text": "Ertrag",
            "fontSize": 14,
            "color": "@muted",
            "spacing": 6
          },
          {
            "type": "Frame",
            "width": 12,
            "height": 12,
            "borderRadius": 2,
            "backgroundColor": "@cons",
            "spacing": 18
          },
          {
            "type": "Text",
            "text": "Verbrauch",
            "fontSize": 14,
            "color": "@muted",
            "spacing": 6
          }
        ]
      }
    },
    "Diagrammseite": {
      "parameters": [
        "block"
      ],
      "item": {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "paddingLeft": 28,
        "paddingRight": 28,
        "paddingTop": 20,
        "items": [
          {
            "type": "Container",
            "direction": "row",
            "justifyContent": "spaceBetween",
            "alignItems": "center",
            "items": [
              {
                "type": "Text",
                "text": "${block.titel}",
                "fontSize": 24,
                "fontWeight": "bold",
                "color": "@text"
              },
              {
                "type": "Legende"
              }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "spacing": 12,
            "data": "${block.summen}",
            "items": [
              {
                "type": "Kachel",
                "label": "${data.label}",
                "value": "${data.value}",
                "farbe": "${data.farbe}",
                "spacing": 10
              }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "alignItems": "end",
            "grow": 1,
            "spacing": 10,
            "data": "${block.balken}",
            "items": [
              {
                "type": "Balkenpaar",
                "label": "${data.label}",
                "yh": "${data.yh}",
                "ch": "${data.ch}",
                "yo": "${data.yo}",
                "co": "${data.co}",
                "yv": "${data.yv}"
              }
            ]
          },
          {
            "type": "Text",
            "text": "${block.fussnote}",
            "fontSize": 13,
            "color": "@muted",
            "spacing": 6,
            "maxLines": 2
          }
        ]
      }
    },
    "Sonnenseite": {
      "parameters": [
        "sonne"
      ],
      "item": {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "paddingLeft": 28,
        "paddingRight": 28,
        "paddingTop": 20,
        "items": [
          {
            "type": "Container",
            "direction": "row",
            "justifyContent": "spaceBetween",
            "alignItems": "center",
            "items": [
              {
                "type": "Text",
                "text": "Sonnenstunden – nächste 7 Tage",
                "fontSize": 24,
                "fontWeight": "bold",
                "color": "@text"
              },
              {
                "type": "Container",
                "direction": "row",
                "alignItems": "center",
                "items": [
                  {
                    "type": "Frame",
                    "width": 12,
                    "height": 12,
                    "borderRadius": 2,
                    "backgroundColor": "@sun"
                  },
                  {
                    "type": "Text",
                    "text": "Sonne",
                    "fontSize": 14,
                    "color": "@muted",
                    "spacing": 6
                  },
                  {
                    "type": "Frame",
                    "width": 12,
                    "height": 12,
                    "borderRadius": 2,
                    "backgroundColor": "@card",
                    "spacing": 18
                  },
                  {
                    "type": "Text",
                    "text": "Tageslicht",
                    "fontSize": 14,
                    "color": "@muted",
                    "spacing": 6
                  }
                ]
              }
            ]
          },
          {
            "type": "Text",
            "text": "${sonne.summe}",
            "fontSize": 16,
            "color": "@muted",
            "spacing": 4
          },
          {
            "type": "Container",
            "direction": "row",
            "alignItems": "end",
            "grow": 1,
            "spacing": 10,
            "data": "${sonne.tage}",
            "items": [
              {
                "type": "Container",
                "grow": 1,
                "height": "100%",
                "justifyContent": "end",
                "alignItems": "center",
                "items": [
                  {
                    "type": "Text",
                    "text": "${data.wert}",
                    "fontSize": 18,
                    "fontWeight": "bold",
                    "color": "${data.farbe}",
                    "maxLines": 1
                  },
                  {
                    "type": "Frame",
                    "width": 56,
                    "height": "${data.track}",
                    "borderRadius": 6,
                    "backgroundColor": "@card",
                    "spacing": 4,
                    "item": {
                      "type": "Container",
                      "width": "100%",
                      "height": "100%",
                      "justifyContent": "end",
                      "items": [
                        {
                          "type": "Frame",
                          "width": "100%",
                          "height": "${data.bar}",
                          "borderRadius": 6,
                          "backgroundColor": "${data.farbe}"
                        }
                      ]
                    }
                  },
                  {
                    "type": "Text",
                    "text": "${data.label}",
                    "fontSize": 16,
                    "color": "@text",
                    "spacing": 6,
                    "maxLines": 1
                  },
                  {
                    "type": "Text",
                    "text": "${data.kwh}",
                    "fontSize": 14,
                    "color": "@muted",
                    "maxLines": 1
                  }
                ]
              }
            ]
          },
          {
            "type": "Text",
            "text": "Sonnenstunden laut Wetterprognose · darunter der erwartete PV-Ertrag des Tages",
            "fontSize": 13,
            "color": "@muted",
            "spacing": 6,
            "maxLines": 1
          }
        ]
      }
    }
  },
  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "items": [
      {
        "type": "Frame",
        "width": "100vw",
        "height": "100vh",
        "backgroundColor": "@bg",
        "item": {
          "type": "Container",
          "width": "100%",
          "height": "100%",
          "items": [
            {
              "type": "Pager",
              "id": "seiten",
              "width": "100%",
              "grow": 1,
              "initialPage": "${payload.page}",
              "navigation": "normal",
              "items": [
                {
                  "type": "Container",
                  "direction": "row",
                  "width": "100%",
                  "height": "100%",
                  "paddingLeft": 28,
                  "paddingRight": 28,
                  "paddingTop": 20,
                  "items": [
                    {
                      "type": "Container",
                      "width": "33%",
                      "items": [
                        {
                          "type": "Text",
                          "text": "${payload.datum}",
                          "fontSize": 18,
                          "color": "@muted",
                          "maxLines": 1
                        },
                        {
                          "type": "Text",
                          "text": "Solarstrom heute",
                          "fontSize": 20,
                          "color": "@text",
                          "spacing": 8
                        },
                        {
                          "type": "Text",
                          "text": "${payload.heuteKwh} kWh",
                          "fontSize": 48,
                          "fontWeight": "bold",
                          "color": "@sun",
                          "maxLines": 1
                        },
                        {
                          "type": "Text",
                          "text": "${payload.heuteWetter}",
                          "fontSize": 16,
                          "color": "@muted",
                          "maxLines": 1
                        },
                        {
                          "type": "Text",
                          "text": "Morgen ${payload.morgenKwh} kWh · ${payload.morgenWetter}",
                          "fontSize": 17,
                          "color": "@text",
                          "spacing": 8,
                          "maxLines": 2
                        },
                        {
                          "type": "Frame",
                          "backgroundColor": "@card",
                          "borderRadius": 12,
                          "spacing": 14,
                          "paddingLeft": 14,
                          "paddingRight": 14,
                          "paddingTop": 6,
                          "paddingBottom": 6,
                          "item": {
                            "type": "Container",
                            "data": "${payload.live}",
                            "items": [
                              {
                                "type": "Container",
                                "direction": "row",
                                "justifyContent": "spaceBetween",
                                "paddingTop": 4,
                                "paddingBottom": 4,
                                "items": [
                                  {
                                    "type": "Text",
                                    "text": "${data.label}",
                                    "fontSize": 15,
                                    "color": "@muted",
                                    "maxLines": 1
                                  },
                                  {
                                    "type": "Text",
                                    "text": "${data.value}",
                                    "fontSize": 17,
                                    "fontWeight": "bold",
                                    "color": "@text",
                                    "maxLines": 1
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "type": "Text",
                          "text": "${payload.jetzt.text}",
                          "fontSize": 16,
                          "color": "${payload.jetzt.farbe}",
                          "spacing": 12,
                          "maxLines": 2
                        }
                      ]
                    },
                    {
                      "type": "Container",
                      "grow": 1,
                      "shrink": 1,
                      "paddingLeft": 28,
                      "items": [
                        {
                          "type": "Text",
                          "text": "Beste Startzeiten",
                          "fontSize": 22,
                          "fontWeight": "bold",
                          "color": "@text"
                        },
                        {
                          "type": "Container",
                          "spacing": 4,
                          "data": "${payload.geraete}",
                          "items": [
                            {
                              "type": "Container",
                              "direction": "row",
                              "alignItems": "center",
                              "paddingTop": 5,
                              "paddingBottom": 5,
                              "items": [
                                {
                                  "type": "Frame",
                                  "width": 12,
                                  "height": 12,
                                  "borderRadius": 6,
                                  "backgroundColor": "${data.farbe}"
                                },
                                {
                                  "type": "Text",
                                  "text": "${data.name}",
                                  "fontSize": 18,
                                  "color": "@text",
                                  "width": 140,
                                  "spacing": 10,
                                  "maxLines": 1
                                },
                                {
                                  "type": "Text",
                                  "text": "${data.wann}",
                                  "fontSize": 18,
                                  "fontWeight": "bold",
                                  "color": "@text",
                                  "grow": 1,
                                  "shrink": 1,
                                  "maxLines": 1
                                },
                                {
                                  "type": "Text",
                                  "text": "${data.info}",
                                  "fontSize": 15,
                                  "color": "@muted",
                                  "spacing": 8,
                                  "maxLines": 1
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "Text",
                          "text": "${payload.hinweis}",
                          "fontSize": 14,
                          "color": "@muted",
                          "spacing": 4,
                          "maxLines": 2
                        },
                        {
                          "type": "Text",
                          "text": "Sonnenstrom-Prognose heute · grün = empfohlene Laufzeit",
                          "fontSize": 14,
                          "color": "@muted",
                          "spacing": 12,
                          "maxLines": 1
                        },
                        {
                          "type": "Container",
                          "direction": "row",
                          "alignItems": "end",
                          "height": 240,
                          "spacing": 4,
                          "data": "${payload.stunden}",
                          "items": [
                            {
                              "type": "Container",
                              "grow": 1,
                              "height": "100%",
                              "justifyContent": "end",
                              "alignItems": "center",
                              "items": [
                                {
                                  "type": "Frame",
                                  "width": "70%",
                                  "height": "${data.h}",
                                  "borderRadius": 3,
                                  "backgroundColor": "${data.c}",
                                  "opacity": "${data.o}"
                                },
                                {
                                  "type": "Text",
                                  "text": "${data.l}",
                                  "fontSize": 13,
                                  "color": "@muted",
                                  "height": 20,
                                  "spacing": 4
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Diagrammseite",
                  "block": "${payload.woche}"
                },
                {
                  "type": "Diagrammseite",
                  "block": "${payload.monat}"
                },
                {
                  "type": "Sonnenseite",
                  "sonne": "${payload.sonne}"
                }
              ]
            },
            {
              "type": "Container",
              "direction": "row",
              "justifyContent": "spaceBetween",
              "paddingLeft": 28,
              "paddingRight": 28,
              "paddingBottom": 10,
              "paddingTop": 4,
              "items": [
                {
                  "type": "Text",
                  "text": "${payload.quelle}",
                  "fontSize": 13,
                  "color": "@muted",
                  "shrink": 1,
                  "maxLines": 1
                },
                {
                  "type": "Text",
                  "text": "Wischen: Heute · Woche · Monat · Sonne   ${payload.stand}",
                  "fontSize": 13,
                  "color": "@muted",
                  "spacing": 12,
                  "maxLines": 1
                }
              ]
            }
          ]
        }
      }
    ]
  }
}